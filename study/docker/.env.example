# Copy to .env and adjust. All values are optional (defaults shown).
# The watcher container reads these on every restart.

# llama-server endpoint (host networking -> 127.0.0.1 works as-is).
LLAMA_BASE_URL=http://127.0.0.1:8000/v1

# Required only if config.env on the server sets API_KEY.
LLAMA_API_KEY=

# low/medium/high: grounded retrieval means we can run the 27B cheap.
REASONING_EFFORT=low

# Total tokens per note (thinking + answer). Bump if notes get cut off.
MAX_TOKENS=4096

# How often the watcher checks books/inbox/ (seconds).
WATCH_INTERVAL_S=300

# CPU threads for docling/embedding (leave headroom for llama-server).
OMP_NUM_THREADS=14

# Web UI (nginx, host network) — see worker-up.sh / worker-down.sh
UI_PORT=8080
UI_FIREWALL_ENABLE=off   # on: worker scripts auto open/close UI_PORT in ufw

# Optional: local multimodal llama-server (qwen2.5-vl GGUF + mmproj) for
# figure descriptions. Empty VLM_BASE_URL disables figure captioning.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=local
DOCLING_IMAGES_SCALE=2.0   # picture crop resolution (72 DPI x scale)

# --- Docling parsing (2.123.1) ---
# Formula -> LaTeX model preset: codeformulav2 (default, specialised) | granite_docling (258M, lighter)
DOCLING_FORMULA_PRESET=codeformulav2
# OCR scope: default (PDF-aware layout regions, fast) | full_page (OCR whole page, best inline-math recovery, slow)
DOCLING_OCR_MODE=default
# OCR language for RapidOCR (PP-OCRv6 codes, e.g. en, ch, ko)
DOCLING_OCR_LANG=en
# Infer proper heading levels (bookmarks/numbering/font style) instead of flat ##
DOCLING_HEADING_HIERARCHY=on

