# Copy to .env and adjust. All values are optional (defaults shown).
# The watcher container reads these on every restart.

# llama-server endpoint (host networking -> 127.0.0.1 works as-is).
LLAMA_BASE_URL=http://127.0.0.1:8000/v1

# Required only if config.env on the server sets API_KEY.
LLAMA_API_KEY=

# low/medium/high: grounded retrieval means we can run the 27B cheap.
REASONING_EFFORT=low

# Total tokens per note (thinking + answer). Bump if notes get cut off.
MAX_TOKENS=4096

# How often the watcher checks books/inbox/ (seconds).
WATCH_INTERVAL_S=300

# --- phase orchestrator (study/pipeline.sh) ---
# on: pipeline.sh starts/stops llama-server (up.sh/down.sh) around generation only
# off: manage llama-server manually (./up.sh ./down.sh); pipeline.sh never touches it
LLM_MANAGED=on
# worker-up.sh starts the background watcher (pipeline.sh watch) when on
WATCHER_ENABLE=on
# how long the generate phase waits for the host to bring llama-server up (seconds)
LLM_START_TIMEOUT_S=180

# CPU threads for docling/embedding (leave headroom for llama-server).
OMP_NUM_THREADS=14

# Optional: local multimodal llama-server (qwen2.5-vl GGUF + mmproj) for
# figure descriptions. Empty VLM_BASE_URL disables figure captioning.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=local
DOCLING_IMAGES_SCALE=2.0   # picture crop resolution (72 DPI x scale)

# --- Docling parsing (2.123.1) ---
# Formula -> LaTeX model preset: codeformulav2 (default, specialised) | granite_docling (258M, lighter)
DOCLING_FORMULA_PRESET=codeformulav2
# OCR scope: default (PDF-aware layout regions, fast) | full_page (OCR whole page, best inline-math recovery, slow)
DOCLING_OCR_MODE=default
# OCR language for RapidOCR (PP-OCRv6 codes, e.g. en, ch, ko)
DOCLING_OCR_LANG=en
# Infer proper heading levels (bookmarks/numbering/font style) instead of flat ##
DOCLING_HEADING_HIERARCHY=on
# Extract bar/pie/line charts as structured data (VLM; auto-enables picture classification)
DOCLING_CHART_EXTRACTION=on
# Code-aware extraction (reuses the codeformula model)
DOCLING_CODE_ENRICHMENT=on
# docling built-in picture description — replaces the custom VLM (figures.py/vlm.py).
# Set =on to try it; switching modes requires --force re-parse (cache key changes).
DOCLING_PICTURE_DESCRIPTION=off
# Native picture description model preset: smolvlm (256M, light) | granite_vision (2B) | pixtral (12B)
DOCLING_PICTURE_PRESET=smolvlm
# Minimum picture area (fraction of page) to describe; lower = describe smaller figures (0.05 = 5%)
DOCLING_PICTURE_AREA_THRESHOLD=0.05
# Layout model: empty = docling default (layout-heron). Try layout_egret_large for dense textbooks (much slower on CPU)
DOCLING_LAYOUT_PRESET=

