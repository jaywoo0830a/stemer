# docker compose 가 study/ 에서 자동 로드합니다 (.env → 컨테이너 env).
#   cp .env.example .env  → 채운 뒤 사용. (.env 는 gitignore 대상)
#
# 참고: docker/run.sh·build.sh 는 study/ 에서 실행되므로 이 파일을 자동으로 사용합니다.

# ---- DeepSeek Flash API (생성 시) ----
DEEPSEEK_API_KEY=
# 지원 모델: deepseek-v4-pro / deepseek-v4-flash / deepseek-v4-flash-vision-exp
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- HuggingFace: 모델 다운로드 가속 ----
# 읽기 전용 토큰: https://huggingface.co/settings/tokens
HF_TOKEN=
# HF 가 느린 네트워크면 미러 사용 (직결이 빠르면 비워두기)
HF_ENDPOINT=https://hf-mirror.com

# ---- (선택) 이미지 빌드: EMBED 는 env 로 제어 (예: EMBED=1 bash docker/build.sh)
# EMBED=1

# ---- 로컬 LLM (Ollama) 후처리 / 문제은행 ----
# POSTKATEX=1 이면 generate 가 렌더된 note 를 로컬 Ollama 로 후처리(기본 off).
# 문제은행 등 범용 로컬 생성은 '범용 모델'을 OLLAMA_MODEL 로 지정한다.
#  (gemma-4-26B-A4B 는 study/install-gemma-4-26b-a4b.sh 참고)
POSTKATEX=0
# network_mode: host 로 컨테이너가 호스트의 127.0.0.1:11434 를 직접 봄
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma-4-26b-a4b

