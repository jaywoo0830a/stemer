# ============================================================
# config.env.example — Qwen3.6-27B CPU 추론 서버 프리셋
#   init.sh가 이 파일을 config.env 로 복사합니다.
#   config.env(로컬 전용)는 git에 올라가지 않습니다.
# ============================================================
# Qwen3.6-27B CPU 추론 서버 설정 (Ryzen 7 9700X / 64GB)
# 퀀트 선택: Q8_0(기본, 최고 품질) · Q6_K/Q5_K_M(절충) · Q4_K_M(최고 속도)
MODEL_REPO="unsloth/Qwen3.6-27B-GGUF"
MODEL_FILE="Qwen3.6-27B-Q8_0.gguf"
MODEL_ALIAS="Qwen3.6-27B"
HOST="127.0.0.1"          # 외부/LAN 공개 시 0.0.0.0 + API_KEY 필수
PORT="8000"
API_KEY=""                # 비워두면 인증 없음(로컬 전용). 0.0.0.0 노출 시 필수 (up.sh가 시작 거부)
# 방화벽(ufw) 자동 개방/폐쇄 — HOST=0.0.0.0 일 때 up.sh가 allow, down.sh가 delete
FIREWALL_ENABLE="off"     # on: 방화벽 자동 조작 / off: 수동 관리
FIREWALL_PORT="8000"      # 개방할 포트 (기본 PORT와 동일)
CTX_SIZE="32768"          # 챕터별 파일 단위 생성 기준 — 64K보다 토큰당 KV 읽기↓ (짧은 대화·단일 요청에 충분)
THREADS="16"
BATCH_SIZE="2048"
KV_CACHE_TYPE="q8_0"
TEMP="0.6"
TOP_P="0.95"
TOP_K="20"
REASONING_EFFORT="medium" # 서버 기본값. 융합 문제·솔루션처럼 엄밀함이 필요한 요청은
                         # per-request로 "high" 재정의 (llama-server 요청 파라미터)
SPEC_TYPE="ngram-mod"    # 추측 디코딩(품질 무손실 — 검증은 메인 모델이 수행). 학습자료 워크플로 기본값
                         #   ngram-mod    : n-gram 해시 풀, 모델 불필요(~16MB) — 코드/템플릿/반복 텍스트↑ (기본)
                         #   ngram-simple : n-gram 패턴 매칭, 모델 불필요
                         #   draft-simple : 소형 드래프트 모델 — 효과 최대 (아래 DRAFT_MODEL_FILE 필요)
                         #   draft-mtp    : 메인 GGUF에 MTP 헤드(nextn) 있을 때만 (기본 unsloth 모델은 없음)
SPEC_DRAFT_N_MAX="3"     # draft 계열일 때 한 번에 예측할 토큰 수 (llama.cpp 기본 3)
SPEC_DRAFT_THREADS="8"   # draft-simple 전용 스레드 (THREADS=16 내 분배, CPU 과점유 방지)
DRAFT_MODEL_REPO="unsloth/Qwen3-1.7B-GGUF"
DRAFT_MODEL_FILE="Qwen3-1.7B-Q8_0.gguf"  # draft-simple용 (~1.7GB, init.sh가 다운로드)
                         # ⚠ 메인 모델과 같은 토크나이저(Qwen3 계열)여야 함 — 불일치 시 시작 실패
MLOCK="on"               # 모델 RAM 고정(스왑 방지). --load-mode mmap+mlock 사용, 문제 시 off
MAX_TOKENS="-1"
HEALTH_TIMEOUT="600"
LLAMA_EXTRA_ARGS=""
